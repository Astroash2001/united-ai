# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings (frontend URLs allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:3000

# LLM Gateway (OpenAI-compatible) - summaries, chat, AI Brain, OCR
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=https://api.experientiallabs.ai/v1
LLM_MODEL=deepseek-v4-flash
LLM_VISION_MODEL=gpt-5.6-luna
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7


# Database (Optional - SQLite by default)
# For production (Render provides this automatically):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Production Settings (for Render deployment)
# DJANGO_SECRET_KEY=generate-a-secure-random-key-for-production
# DEBUG=False
# ALLOWED_HOSTS=your-app-name.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Deepgram - live and uploaded audio/video transcription. Create the key with the Member role
# (Default-role keys cannot issue the short-lived browser tokens).
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional web sources for document chat
# JINA_API_KEY=      # Jina Reader: works without a key at a lower rate limit
# TAVILY_API_KEY=    # Tavily web search

# Optional limits
# MAX_MEDIA_FILE_SIZE_MB=200
# THROTTLE_AI_TEXT=60/hour
# THROTTLE_AI_HEAVY=20/hour
# THROTTLE_LIVE_TOKEN=30/hour
# THROTTLE_HISTORY=600/hour
# GUNICORN_TIMEOUT=600
